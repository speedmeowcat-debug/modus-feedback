# База данных.
# Пусто  -> встроенный Postgres (PGlite), данные лежат в каталоге PGLITE_DIR.
#           Подходит для локального запуска и демонстрации с одного сервера.
# Задано -> обычный PostgreSQL (Supabase, Neon, свой сервер).
#           Нужен для Vercel и любого размещения без постоянного диска.
DATABASE_URL=
PGLITE_DIR=

# Демо-режим: на странице входа показываются кнопки входа под тестовыми аккаунтами.
# В рабочей среде поставьте false.
DEMO_MODE=true

# Пароль, который получают демо-аккаунты при первом заполнении базы.
# Читается только сид-скриптом. Пусто -> пароль локального демо по умолчанию.
# Для публичного размещения задайте свой пароль в настройках хостинга.
DEMO_PASSWORD=
