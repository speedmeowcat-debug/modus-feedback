{
  "name": "modus-feedback-film",
  "version": "1.0.0",
  "private": true,
  "description": "60-секундный продуктовый ролик Modus Feedback (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "timeline": "node scripts/export-timeline.mjs",
    "audio": "npm run timeline && python tools/render_audio.py out/timeline.json --out out && node scripts/copy-audio.mjs",
    "render": "remotion render src/index.ts ModusFilm out/modus-feedback-film.mp4",
    "still": "remotion still src/index.ts ModusFinal out/final-frame.png --frame=179",
    "render:final": "remotion render src/index.ts ModusFinal out/modus-feedback-final.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.542",
    "@remotion/google-fonts": "^4.0.542",
    "@remotion/motion-blur": "^4.0.542",
    "@remotion/tailwind-v4": "^4.0.542",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9"
  }
}
