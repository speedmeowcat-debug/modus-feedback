{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "motion-director timeline export (tools/export_timeline.mjs / harness timeline.json)",
  "type": "object",
  "required": ["version", "spec", "cues"],
  "properties": {
    "version": {"type": "integer"},
    "spec": {"type": "object", "required": ["id", "fps", "width", "height", "durationInFrames"],
      "properties": {"id": {"type": "string"}, "fps": {"type": "number"}, "width": {"type": "integer"}, "height": {"type": "integer"}, "durationInFrames": {"type": "integer"}}},
    "music": {"type": ["object", "null"], "required": ["bpm", "key", "mode", "bars", "progression", "layers"],
      "properties": {
        "bpm": {"type": "number"}, "key": {"type": "string", "description": "pitch class: A, C#, Eb ..."},
        "mode": {"enum": ["minor", "major", "dorian", "lydian", "phrygian", "mixolydian"]},
        "bars": {"type": "integer"}, "progression": {"type": "array", "items": {"type": "integer"}, "description": "scale degrees, one per bar, cycled"},
        "layers": {"type": "object", "properties": {"pad": {"type": "number"}, "bass": {"type": "number"}, "arp": {"type": "number"}, "kick": {"type": "number"}, "hat": {"type": "number"}, "clap": {"type": "number"}, "pulse": {"type": "number"}}},
        "arc": {"type": "array", "items": {"type": "object", "required": ["bar", "energy"], "properties": {"bar": {"type": "integer"}, "energy": {"type": "number"}}}}}},
    "mix": {"type": "object", "properties": {"targetLufs": {"type": "number"}, "truePeakDb": {"type": "number"}, "musicDb": {"type": "number"}, "fadeOut": {"type": "number"}}},
    "cues": {"type": "array", "items": {
      "type": "object", "required": ["id", "kind", "frame", "scores", "anchor"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"enum": ["impact", "thud", "whoosh", "riser", "sweep", "swell", "click", "tick", "pop", "snap", "type", "blip", "chime", "shimmer"]},
        "frame": {"type": "integer", "description": "the picture frame this sound is bound to"},
        "scores": {"type": "string", "minLength": 3, "description": "the visual event this sound belongs to (required)"},
        "dur": {"type": "number"}, "intensity": {"type": "number", "minimum": 0, "maximum": 1},
        "pan": {"type": "number", "minimum": -1, "maximum": 1}, "pitch": {"type": ["string", "number", "null"]},
        "anchor": {"enum": ["start", "peak", "end"]}, "peak": {"type": "number"}, "brightness": {"type": "number", "minimum": 0, "maximum": 1}
      }}},
    "holds": {"type": "array"}, "cuts": {"type": "array"}, "events": {"type": ["object", "array"]}
  }
}
